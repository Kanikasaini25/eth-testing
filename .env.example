# =============================================================================
# Copy to .env and fill in secrets:
#   cp .env.example .env
# Omitted knobs use defaults in src/product_specs.py / mt5_broker.py
# =============================================================================

# -----------------------------------------------------------------------------
# Delta Exchange (India)
# Candles always use India LIVE. For live orders use production URL + live keys:
#   DELTA_BASE_URL=https://api.india.delta.exchange
# Gold = PAXGUSD (XAUUSD is not listed on Delta).
# -----------------------------------------------------------------------------
DELTA_BASE_URL=https://api.india.delta.exchange
DELTA_API_KEY=your_api_key_here
DELTA_API_SECRET=your_api_secret_here
DELTA_SYMBOL=PAXGUSD
DELTA_RESOLUTION=15m
# PAXGUSD max on Delta India is typically 20x
DELTA_LEVERAGE=20

# -----------------------------------------------------------------------------
# Position sizing
# ~$200 @ 20x → use ~750 lots; 2000 lots needs ~$450+ wallet
# -----------------------------------------------------------------------------
POSITION_LOTS=750

# -----------------------------------------------------------------------------
# Strategy — custom vs code defaults (Hammer / Shooting Star)
# -----------------------------------------------------------------------------
TARGET_POINTS=28
PARTIAL_EXIT_PCT=45
EXIT_SCALE_PCTS=45,30,15,5
MIN_PATTERN_POINTS=1.5
MAX_SL_POINTS=22
MIN_RR_RATIO=1.2
BREAKEVEN_POINTS=12
USE_SESSION_FILTER=false

# -----------------------------------------------------------------------------
# Local MT5 / PDMBulls (true XAUUSD CFD)
# -----------------------------------------------------------------------------
MT5_LOGIN=your_demo_login
MT5_PASSWORD=your_demo_password
MT5_SERVER=PDMBulls-Server
MT5_SYMBOL=XAUUSD

# -----------------------------------------------------------------------------
# Email alerts
# -----------------------------------------------------------------------------
EMAIL_NOTIFY_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=your_email@gmail.com
NOTIFY_EMAIL=you@gmail.com
