# Copy this file to .env and add your values:
#   cp .env.example .env

STRATEGY=funding

# Books to run. ETH and BTC funding stayed ~78% one-sided over the last year;
# SOL and XRP flipped too often and lost to fees.
SYMBOLS=ETHUSD,BTCUSD

# USD exposure per book. Lots are derived from it, so every book carries the
# same notional despite different contract sizes.
NOTIONAL_USD=2450

# Only used when a single book is run without notional sizing.
POSITION_LOTS=100
DELTA_SYMBOL=ETHUSD

# Funding cash-and-carry (rate is percent; both signs)
FUNDING_THRESHOLD_PCT=0.005
FUNDING_CONFIRM_PERIODS=2
FUNDING_INTERVAL_HOURS=8
FUNDING_MIN_SETTLEMENTS=8
FUNDING_FEE_MARGIN=1.0
FUNDING_FUTURES_MAKER=true
FUNDING_EXIT_CONFIRM=2
FUNDING_REQUIRE_MOMENTUM=false
FUNDING_SKIP_MINUTES_BEFORE_SETTLE=30
FUNDING_STRONG_RATE_PCT=0.02

# Required only for scripts/run_live.py --live
DELTA_BASE_URL=https://api.india.delta.exchange
DELTA_API_KEY=your_api_key_here
DELTA_API_SECRET=your_api_secret_here

# Email alerts (comma-separated)
EMAIL_NOTIFY_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=your_email@gmail.com
NOTIFY_EMAIL=you@gmail.com,other@gmail.com
