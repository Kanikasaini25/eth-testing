# Copy this file to .env and add your values:
#   cp .env.example .env

# Strategy rules JSON (relative to project root)
STRATEGY_RULES=data/strategies/lqdty_liquidity.json
STRATEGY_M15_RULES=data/strategies/wI9b968AvW8_rules.json

# Delta Exchange settings
# Demo/testnet (bot orders): https://cdn-ind.testnet.deltaex.org
# Live India (backtest candles always): https://api.india.delta.exchange
DELTA_BASE_URL=https://cdn-ind.testnet.deltaex.org
DELTA_API_KEY=your_api_key_here
DELTA_API_SECRET=your_api_secret_here
DELTA_SYMBOL=ETHUSD
DELTA_RESOLUTION=1d

# Backtest period: same days for 1d lines + 1m entries (1 day = 1440 1m candles, max 365)
BACKTEST_DAYS=30

# Simulated starting wallet for trade log P&L
STARTING_WALLET_USD=10000

# Email alerts on LQDTY entry signals (SMTP)
EMAIL_NOTIFY_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=your_email@gmail.com
NOTIFY_EMAIL=your_email@gmail.com
