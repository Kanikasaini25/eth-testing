# Copy this file to .env and add your values:
#   cp .env.example .env

DELTA_SYMBOL=ETHUSD

# Public India-live candles for signals and backtests (no API key).
DELTA_DATA_BASE_URL=https://api.india.delta.exchange

# Demo/testnet orders. Switch to https://api.india.delta.exchange only for real money.
DELTA_BASE_URL=https://cdn-ind.testnet.deltaex.org
DELTA_API_KEY=your_demo_api_key_here
DELTA_API_SECRET=your_demo_api_secret_here

# Email alerts (comma-separated). Sent on buy/sell signals, fills, 80% TP, and closes.
EMAIL_NOTIFY_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=your_email@gmail.com
NOTIFY_EMAIL=you@gmail.com,other@gmail.com
