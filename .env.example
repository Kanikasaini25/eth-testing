# Copy this file to .env and add your values:
#   cp .env.example .env

# YouTube video URL to analyze
YOUTUBE_URLS=https://www.youtube.com/watch?v=VIDEO_ID

# Transcript language(s)
LANGUAGES=en
# Set true only when YouTube must be reached through HTTP(S)_PROXY
YOUTUBE_USE_ENV_PROXY=false

# Delta Exchange settings
# Trade account (orders/positions) — demo/testnet or live
# Demo India: https://cdn-ind.testnet.deltaex.org
# Live India: https://api.india.delta.exchange
DELTA_BASE_URL=https://cdn-ind.testnet.deltaex.org
DELTA_API_KEY=your_api_key_here
DELTA_API_SECRET=your_api_secret_here
# Market data for live strategy signals (India live candles + mark)
DELTA_DATA_BASE_URL=https://api.india.delta.exchange
# Set true only when Delta must be reached through HTTP(S)_PROXY
DELTA_USE_ENV_PROXY=false
DELTA_SYMBOL=ETHUSD
DELTA_RESOLUTION=1d

# Backtest period: same days for 1d lines + 1m entries (1 day = 1440 1m candles, max 365)
BACKTEST_DAYS=30

# Simulated starting wallet for trade log P&L
STARTING_WALLET_USD=10000

# Legacy transcript-only output (optional)
OUTPUT_FILE=transcripts.txt

# Email alerts on LQDTY entry signals (SMTP)
EMAIL_NOTIFY_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=your_email@gmail.com
NOTIFY_EMAIL=your_email@gmail.com
