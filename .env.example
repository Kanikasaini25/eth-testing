# Copy this file to .env and add your values:
#   cp .env.example .env

# Delta Exchange settings
# Trade account (orders/positions) — demo/testnet or live
# Demo India: https://cdn-ind.testnet.deltaex.org
# Live India: https://api.india.delta.exchange
DELTA_BASE_URL=https://cdn-ind.testnet.deltaex.org
DELTA_API_KEY=your_api_key_here
DELTA_API_SECRET=your_api_secret_here
# Market data for live strategy signals (India live candles + mark)
DELTA_DATA_BASE_URL=https://api.india.delta.exchange
# Set true only when Delta must be reached through HTTP(S)_PROXY
DELTA_USE_ENV_PROXY=false
DELTA_SYMBOL=ETHUSD

# ETH India volume-bias live strategy
# Watch buy vs sell volume until 19:00 IST (7:00 PM), then one pullback entry
ETH_ENTRY_HOUR_IST=19
# Close full position at +5%. Initial SL = 15m wick.
# Trail: +1% keep wick SL; +2% move SL to +1%; +3%→+2%; +4%→+3%.
ETH_TARGET_PCT=5
ETH_POSITION_LOTS=100
ETH_PULLBACK_RESOLUTION=15m
ETH_ENTRY_RESOLUTION=1m

# Backtest date-range default (India-live 15m pullback + 1m entry)
BACKTEST_DAYS=30
STARTING_WALLET_USD=10000

# Email alerts on ETH volume-bias entry/exit (SMTP)
EMAIL_NOTIFY_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=your_email@gmail.com
NOTIFY_EMAIL=your_email@gmail.com
