# Copy this file to .env and add your values:
#   cp .env.example .env

# Public candle history does not need API keys (always fetched from India live production).
# Gold on Delta: use PAXGUSD (or XAUTUSD). Classic XAUUSD is NOT listed on Delta.
DELTA_SYMBOL=PAXGUSD
DELTA_RESOLUTION=15m

# Required only for scripts/run_live.py --live (use India live, not testnet)
DELTA_BASE_URL=https://api.india.delta.exchange
DELTA_API_KEY=your_api_key_here
DELTA_API_SECRET=your_api_secret_here

# Lot size: 1000 ≈ $1/$1 on PAXGUSD; 3000 ≈ $3/$1 (higher-frequency opt default)
TARGET_USD_PER_POINT=1
POSITION_LOTS=3000
TARGET_POINTS=28
TREND_LOOKBACK=6
MIN_CONFIRM_BODY=0.5
PARTIAL_EXIT_PCT=45
EXIT_SCALE_PCTS=45,30,15,5
MAX_TARGETS=5
MIN_SHADOW_RATIO=2.5
MIN_PATTERN_POINTS=1.5
MAX_SL_POINTS=22
MIN_RR_RATIO=1.2
BREAKEVEN_POINTS=12
MIN_OVERLAY_VOTES=2

# Trend regime (EMA + ADX + Donchian)
USE_EMA_REGIME=true
EMA_FAST=20
EMA_SLOW=50
USE_ADX_FILTER=true
ADX_PERIOD=14
ADX_MIN=20
USE_DONCHIAN_FILTER=true
DONCHIAN_PERIOD=20

# Mean-reversion confirm (Bollinger + wider gold RSI 25/75)
USE_BOLLINGER_RSI=true
BB_PERIOD=20
BB_STD=2.0
RSI_PERIOD=14
RSI_OVERSOLD=25
RSI_OVERBOUGHT=75

# ATR volatility stops / adaptive targets
USE_ATR_STOPS=true
ATR_PERIOD=14
ATR_STOP_MULT=1.5
ATR_TARGET_MULT=2.0
ATR_MAX_RISK_MULT=2.0
USE_ADAPTIVE_TARGETS=true

# Session filter UTC (off in best low-SL opt; set true to re-enable)
USE_SESSION_FILTER=false
SESSION_LONDON_START=7
SESSION_LONDON_END=10
SESSION_OVERLAP_START=12
SESSION_OVERLAP_END=16

# Local MT5 / PDMBulls — true XAUUSD CFD
MT5_LOGIN=your_demo_login
MT5_PASSWORD=your_demo_password
MT5_SERVER=PDMBulls-ServerMT5
MT5_SYMBOL=XAUUSD
MT5_VOLUME=0.10
MT5_CANDLE=15m

# Email alerts
EMAIL_NOTIFY_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=your_email@gmail.com
NOTIFY_EMAIL=you@gmail.com
