# =============================================================================
# Copy to .env and fill in secrets:
#   cp .env.example .env
# Omitted knobs use defaults in src/product_specs.py
# =============================================================================

# -----------------------------------------------------------------------------
# Delta Exchange (India)
# Candles always use India LIVE. Orders use DELTA_BASE_URL + keys.
# Testnet demo:  https://cdn-ind.testnet.deltaex.org
# Live orders:   https://api.india.delta.exchange
# Gold = PAXGUSD (XAUUSD is not listed on Delta).
# -----------------------------------------------------------------------------
DELTA_BASE_URL=https://cdn-ind.testnet.deltaex.org
DELTA_API_KEY=your_api_key_here
DELTA_API_SECRET=your_api_secret_here
DELTA_SYMBOL=PAXGUSD
DELTA_RESOLUTION=15m
# PAXGUSD max on Delta is typically 20x
DELTA_LEVERAGE=20

# -----------------------------------------------------------------------------
# Position sizing (live)
# ~$200 @ 20x → ~750 lots; 2000 lots needs ~$450+ wallet
# -----------------------------------------------------------------------------
POSITION_LOTS=750

# -----------------------------------------------------------------------------
# Strategy — Hammer / Shooting Star (live + backtest)
# Live exits: PARTIAL_EXIT_PCT at T1, runner aims RUNNER_TARGET_POINTS
# -----------------------------------------------------------------------------
TARGET_POINTS=28
PARTIAL_EXIT_PCT=45
RUNNER_TARGET_POINTS=200
EXIT_SCALE_PCTS=45,30,15,5
MIN_PATTERN_POINTS=1.5
MAX_SL_POINTS=22
MIN_RR_RATIO=1.2
BREAKEVEN_POINTS=12
USE_SESSION_FILTER=false
USE_LIVE_EXITS=true
# Streamlit: "Testnet match live" uses India LIVE entries + testnet 1m exits (demo orders)

# -----------------------------------------------------------------------------
# Email alerts
# -----------------------------------------------------------------------------
EMAIL_NOTIFY_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=your_email@gmail.com
NOTIFY_EMAIL=you@gmail.com
