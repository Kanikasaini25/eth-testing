# Isolated BB/RSI bot credentials. Copy to .env:
#   cp .env.example .env

# Delta Exchange Testnet (India sandbox)
DELTA_BASE_URL=https://cdn-ind.testnet.deltaex.org
DELTA_API_KEY=your_api_key_here
DELTA_API_SECRET=your_api_secret_here

# India testnet perpetual: ETHUSD. Global testnet may use ETHUSDT.
DELTA_SYMBOL=ETHUSD

# Optional WebSocket override (defaults from DELTA_BASE_URL)
# DELTA_WS_URL=wss://socket-ind.testnet.deltaex.org

# Risk (USD)
DAILY_TRADE_CAP=4
DAILY_MAX_LOSS_USD=14
PER_TRADE_STOP_USD=3.50
TAKE_PROFIT_USD=10
PROFIT_LOCK_USD=5
MAX_PROFIT_USD=20

# Fixed size: 100 lots = 1 ETH on ETHUSD (1 lot = 0.01 ETH)
FIXED_LOTS=100

# Delta India taker fee: 0.05% of notional on entry AND 0.05% on exit
FEE_PCT_PER_SIDE=0.05

# After fees, +$5 lock cannot cover a -$3.50 stop. Leave false to wait for TP.
ENABLE_TRAILING_LOCK=false
TRAIL_TO_MAX_PROFIT=false
# Place TP / lock / max so the dollar amounts are take-home after round-trip fees.
NET_TARGETS_OF_FEES=true

# After a losing trade, wait this many minutes before the next entry.
LOSS_COOLDOWN_MINUTES=15
# Max stop-losses in one open (London or US). A profit ends that open.
MAX_SESSION_STOPS=2

POLL_SECONDS=10
