[Unit]
Description=LQDTY ETH live trading bot (Delta Exchange)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/youtube
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/youtube/.venv/bin/python scripts/run_live_strategy.py --loop --enable --interval 60
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
