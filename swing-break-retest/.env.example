# Copy this file to .env and add your values:
#   cp .env.example .env

# Delta Exchange settings
# Demo/testnet India: https://cdn-ind.testnet.deltaex.org
# Live India:         https://api.india.delta.exchange
DELTA_BASE_URL=https://cdn-ind.testnet.deltaex.org
DELTA_SYMBOL=ETHUSD

# Backtest period (days of 5m candles; max 365)
BACKTEST_DAYS=30

# Simulated starting wallet for trade log P&L
STARTING_WALLET_USD=10000
